-- OC-IEC61850-SAS SCADA configuration.
--
-- Copy this file to /etc/sas-scada.cfg and edit it. Plain Lua table
-- literal (serialization.unserialize) -- see sas-ied.cfg.example's header
-- for the same syntax notes. Restart after editing: rc scadad restart
--
-- Requires a modem component on this machine (wired or wireless network
-- card) -- see sas-ied.cfg.example's header. No separate networking
-- daemon/config needed.
{
  -- Name this SCADA answers "who-is" discovery queries for -- must match
  -- every sas-hmi.cfg's `scada` field on every HMI node that talks to it.
  scadaName = "SCADA",

  -- MMS-lite server port for HMI clients, opened on this machine's modem.
  hms = { port = 8103 },

  -- GOOSE subscriber -- must match the modem port every IED's goose.port
  -- broadcasts/listens on (see sas-ied.cfg.example's goose.port comment).
  goose = { port = 8104 },

  tickIntervalSec = 0.2,

  -- Defense-in-depth full "read" refresh per IED, on top of (not instead
  -- of) each IED's own periodic integrity broadcast.
  resyncSec = 60,

  connectTimeoutSec = 5,
  reconnectIntervalSec = 10,

  -- How long a publishing IED can go without a GOOSE datagram before its
  -- GOOSE-sourced points are marked stale and a comm alarm is raised.
  gooseStaleAfterSec = 15,

  -- Every IED this SCADA connects to. SCADA does NOT need each IED's
  -- address, port, or point list here -- `name` (which must exactly
  -- match that IED's own `iedName`) is resolved to a modem
  -- address/port at runtime via discovery, and the point list is learned
  -- automatically via get-model on connect.
  ieds = {
    { name = "IED-BRK1" },
    -- { name = "IED-BRK2" },
  },

  historian = {
    dir = "/var/log/sas-scada",
    maxBytes = 262144,
    maxFiles = 5,
  },

  -- User-defined alarm conditions, evaluated every tick against the live
  -- aggregate database. `ref` is a fully qualified point reference
  -- ("<iedName>/<ldName>/<LN>.<DOName>"); `condition` is one of
  -- "eq"|"ne"|"lt"|"gt".
  -- Bus undervoltage as three phase-pair alarms, not one: a single-phase
  -- sag (the common case for an unbalanced fault) only depresses one of
  -- VolAB/VolBC/VolCA, so alarming on just one pair would miss it.
  alarms = {
    {
      id = "V1_LOW_AB", ref = "IED-BRK1/LD0/MMXU1.VolAB", condition = "lt", value = 200,
      severity = "medium", message = "Bus 1 undervoltage (AB)",
    },
    {
      id = "V1_LOW_BC", ref = "IED-BRK1/LD0/MMXU1.VolBC", condition = "lt", value = 200,
      severity = "medium", message = "Bus 1 undervoltage (BC)",
    },
    {
      id = "V1_LOW_CA", ref = "IED-BRK1/LD0/MMXU1.VolCA", condition = "lt", value = 200,
      severity = "medium", message = "Bus 1 undervoltage (CA)",
    },
    {
      id = "BRK1_OPEN", ref = "IED-BRK1/LD0/XCBR1.Pos", condition = "eq", value = "open",
      severity = "high", message = "Breaker 1 open",
    },
  },
}
